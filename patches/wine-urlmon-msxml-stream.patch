diff --git a/dlls/urlmon/binding.c b/dlls/urlmon/binding.c
index b36fa161781..167568d0e01 100644
--- a/dlls/urlmon/binding.c
+++ b/dlls/urlmon/binding.c
@@ -1506,6 +1506,16 @@ static HRESULT Binding_Create(IMoniker *mon, Binding *binding_ctx, IUri *uri, IB
         return hres;
     }
 
+    /* Native MSXML asks URLMon for an asynchronous IStream, but its load()
+     * implementation expects a readable stream when BindToStorage returns.
+     * Wine currently returns MK_S_ASYNCHRONOUS before the first WinINet
+     * callback, so MSXML reports a successful load with an empty document and
+     * immediately aborts the binding.  Keep this synchronous, cache-backed
+     * compatibility path opt-in for the private SOLIDWORKS runtime. */
+    if (IsEqualGUID(&IID_IStream, riid) &&
+        GetEnvironmentVariableW(L"SOLIDWORKS_URLMON_SYNC_BINDTOSTORAGE", NULL, 0))
+        ret->bindf &= ~(BINDF_ASYNCHRONOUS | BINDF_ASYNCSTORAGE);
+
     TRACE("bindf %08lx\n", ret->bindf);
     dump_BINDINFO(&ret->bindinfo);
 
@@ -1551,12 +1561,26 @@ static HRESULT Binding_Create(IMoniker *mon, Binding *binding_ctx, IUri *uri, IB
     return S_OK;
 }
 
+static void wait_for_binding(Binding *binding)
+{
+    MSG msg;
+
+    while (!(binding->state & BINDING_STOPPED))
+    {
+        MsgWaitForMultipleObjects(0, NULL, FALSE, 5000, QS_POSTMESSAGE);
+        while (PeekMessageW(&msg, binding->notif_hwnd, WM_USER, WM_USER + 117, PM_REMOVE | PM_NOYIELD))
+        {
+            TranslateMessage(&msg);
+            DispatchMessageW(&msg);
+        }
+    }
+}
+
 static HRESULT start_binding(IMoniker *mon, Binding *binding_ctx, IUri *uri, IBindCtx *pbc,
                              BOOL to_obj, REFIID riid, Binding **ret)
 {
     Binding *binding = NULL;
     HRESULT hres;
-    MSG msg;
 
     hres = Binding_Create(mon, binding_ctx, uri, pbc, to_obj, riid, &binding);
     if(FAILED(hres))
@@ -1595,14 +1619,8 @@ static HRESULT start_binding(IMoniker *mon, Binding *binding_ctx, IUri *uri, IBi
         }
     }
 
-    while(!(binding->bindf & BINDF_ASYNCHRONOUS) &&
-          !(binding->state & BINDING_STOPPED)) {
-        MsgWaitForMultipleObjects(0, NULL, FALSE, 5000, QS_POSTMESSAGE);
-        while (PeekMessageW(&msg, binding->notif_hwnd, WM_USER, WM_USER+117, PM_REMOVE|PM_NOYIELD)) {
-            TranslateMessage(&msg);
-            DispatchMessageW(&msg);
-        }
-    }
+    if (!(binding->bindf & BINDF_ASYNCHRONOUS))
+        wait_for_binding(binding);
 
     *ret = binding;
     return S_OK;
