+static HINTERNET get_sync_internet_session(IInternetBindInfo *bind_info)
+{
+    HINTERNET new_session;
+
+    if (sync_internet_session)
+        return sync_internet_session;
+
+    if (!bind_info)
+        return NULL;
+
+    new_session = create_internet_session(bind_info, 0);
+    if (new_session && InterlockedCompareExchangePointer((void **)&sync_internet_session, new_session, NULL))
+        InternetCloseHandle(new_session);
+
+    return sync_internet_session;
+}
+
